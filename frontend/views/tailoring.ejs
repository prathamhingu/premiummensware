<%- include('partials/head') %>
<%- include('partials/nav', { activePage }) %>
<main>
  <section class="page-hero page-hero-dark page-hero-tailoring"><div class="container page-hero__inner"><p class="eyebrow eyebrow-gold"><span class="eyebrow-line"></span> PERSONALIZED TAILORING</p><h1>Made to your measure.<br><em>Considered in every detail.</em></h1><p>Bring your idea, choose from the available fabrics, and discuss the fit and details for your garment in person.</p><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Tailoring</span></div></div><div class="page-hero__image"><img src="<%= stockImages.tailoring %>" alt="Editorial tailoring inspiration" loading="lazy"></div></section>
  <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow"><span class="eyebrow-line"></span> TAILORING SERVICES</p><h2>Start with what <em>you have in mind.</em></h2><p class="section-subtitle">Explore the service categories below. Designs, finishing options, timelines, and prices are confirmed directly with the store.</p></div>
    <div class="tailoring-list">
      <article class="tailoring-row" id="shirts"><div class="tailoring-row__number">01</div><div class="tailoring-row__image"><img src="<%= stockImages.shirting %>" alt="Editorial shirt fabric inspiration" loading="lazy"></div><div class="tailoring-row__content"><p class="eyebrow">EVERYDAY · FORMAL · SMART CASUAL</p><h3>Custom Shirts</h3><p>Choose a shirt fabric and discuss the fit and details that suit your wardrobe, from everyday wear to a more formal finish.</p><ul class="detail-list"><li>Fabric selection</li><li>Fit and measurement discussion</li><li>Style and finishing preferences</li></ul><a href="/contact" class="text-link">Discuss a shirt <span aria-hidden="true">↗</span></a></div></article>
      <article class="tailoring-row" id="trousers"><div class="tailoring-row__number">02</div><div class="tailoring-row__image"><img src="<%= stockImages.trousers %>" alt="Editorial trouser styling inspiration" loading="lazy"></div><div class="tailoring-row__content"><p class="eyebrow">FORMAL · SMART · VERSATILE</p><h3>Tailored Trousers & Pants</h3><p>Explore fabric options and talk through the shape and practical details you prefer for your tailored trousers.</p><ul class="detail-list"><li>Fabric and colour choices</li><li>Fit and silhouette discussion</li><li>Style details confirmed in store</li></ul><a href="/contact" class="text-link">Discuss trousers <span aria-hidden="true">↗</span></a></div></article>
      <article class="tailoring-row" id="jabbha"><div class="tailoring-row__number">03</div><div class="tailoring-row__image"><img src="<%= stockImages.detail %>" alt="Editorial fabric detail for traditional menswear inspiration" loading="lazy"></div><div class="tailoring-row__content"><p class="eyebrow">TRADITIONAL MENSWEAR</p><h3>Men's Jabbha</h3><p>Discuss the traditional style you have in mind, fabric options, preferred fit, and the details available for your garment.</p><ul class="detail-list"><li>Traditional style discussion</li><li>Fabric selection</li><li>Measurement and finishing details</li></ul><a href="/contact" class="text-link">Discuss a Jabbha <span aria-hidden="true">↗</span></a></div></article>
      <article class="tailoring-row" id="suits"><div class="tailoring-row__number">04</div><div class="tailoring-row__image"><img src="<%= stockImages.suiting %>" alt="Editorial suiting inspiration" loading="lazy"></div><div class="tailoring-row__content"><p class="eyebrow">WEDDINGS · WORK · SPECIAL OCCASIONS</p><h3>Suits & Suiting</h3><p>Explore suiting fabric and discuss a coordinated formal look for business, weddings, celebrations, or other special events.</p><ul class="detail-list"><li>Suiting fabric selection</li><li>Design and fit discussion</li><li>Tailoring scope confirmed in person</li></ul><a href="/suiting" class="text-link">Explore suiting <span aria-hidden="true">↗</span></a></div></article>
    </div>
  </div></section>
  <section class="process-section"><div class="container"><div class="section-heading section-heading-light"><p class="eyebrow eyebrow-gold"><span class="eyebrow-line"></span> HOW TO BEGIN</p><h2>A clear process.<br><em>A garment that's yours.</em></h2></div><div class="process-grid"><article><span>01</span><h3>Visit the store</h3><p>Share the occasion and garment you have in mind.</p></article><article><span>02</span><h3>Explore fabrics</h3><p>Review available options, colours, and textures in person.</p></article><article><span>03</span><h3>Discuss the details</h3><p>Talk through your preferred design, fit, and finishing.</p></article><article><span>04</span><h3>Confirm your order</h3><p>Measurements, price, timeline, and collection arrangements are confirmed with the store.</p></article></div></div></section>
  <%- include('partials/store-visit-strip') %>
  <section class="visit-cta visit-cta-light"><div class="container visit-cta__inner"><div><p class="eyebrow"><span class="eyebrow-line"></span> LET'S TALK DETAILS</p><h2>Tell us what<br><em>you're looking for.</em></h2><p>Bring an inspiration, an occasion, or simply an idea. Call ahead to check store hours and discuss whether the service you need is currently available.</p></div><div class="visit-cta__actions"><% if (settings.phone && phoneDigits(settings.phone)) { %><a href="tel:<%= phoneDigits(settings.phone) %>" class="button button-dark">Call the Store <span aria-hidden="true">↗</span></a><% } %><a href="/contact#contact-details" class="button button-outline">Visit Information <span aria-hidden="true">↗</span></a></div></div></section>
</main>
