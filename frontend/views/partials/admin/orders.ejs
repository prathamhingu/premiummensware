<section class="admin-section" id="orders">
  <div class="admin-section-head"><div><p class="admin-kicker">09 / TAILORING WORKROOM</p><h2>Tailoring order management</h2><p>Create an internal job card for a customer order, track individual garments, and print a clean A4 work card. This is not an online checkout or payment system.</p></div><span class="admin-section-badge"><%= orders.filter((order) => !order.archived && order.status !== 'cancelled' && !['collected'].includes(orderStatusLabel(order).toLowerCase())).length %> ACTIVE RECORDS</span></div>
  <div class="admin-create-panel">
    <h3>Create a tailoring order</h3>
    <p class="admin-help-note">You can create an order directly from a physical-store visit, an appointment, or an enquiry. A source appointment or enquiry is optional.</p>
    <form action="/admin/orders/create" method="post" class="admin-form-grid" data-order-create-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-field"><label for="order-customer-name">Customer name *</label><input id="order-customer-name" name="customerName" required minlength="2" maxlength="100" value="<%= orderPrefill.customerName %>"></div>
      <div class="form-field"><label for="order-phone">Contact number</label><input id="order-phone" name="phone" maxlength="40" value="<%= orderPrefill.phone %>"></div>
      <div class="form-field"><label for="order-email">Email <small>(optional)</small></label><input id="order-email" type="email" name="email" maxlength="160" value="<%= orderPrefill.email %>"></div>
      <div class="form-field"><label for="order-date">Order date *</label><input id="order-date" type="date" name="orderDate" value="<%= todayKey %>" required></div>
      <div class="form-field"><label for="order-collection-date">Expected collection date <small>(only if agreed)</small></label><input id="order-collection-date" type="date" name="expectedCollectionDate" min="<%= todayKey %>"></div>
      <div class="form-field"><label for="order-appointment">Related appointment <small>(optional)</small></label><select id="order-appointment" name="appointmentId"><option value="">No appointment linked</option><% appointments.slice().reverse().forEach((appointment) => { %><option value="<%= appointment.id %>" <%= orderPrefill.appointmentId === appointment.id ? 'selected' : '' %>><%= appointment.reference %> · <%= appointment.name %> · <%= appointment.date %> (<%= appointmentStatusLabels[appointment.status] || appointment.status %>)</option><% }) %></select></div>
      <div class="form-field"><label for="order-enquiry">Related enquiry <small>(optional)</small></label><select id="order-enquiry" name="enquiryId"><option value="">No enquiry linked</option><% enquiries.forEach((enquiry) => { %><option value="<%= enquiry.id %>" <%= orderPrefill.enquiryId === enquiry.id ? 'selected' : '' %>><%= enquiry.name %> · <%= enquiry.subject || 'Website enquiry' %> · <%= new Date(enquiry.createdAt).toLocaleDateString('en-IN') %></option><% }) %></select></div>
      <div class="form-field field-span-2"><label for="order-notes">Order notes <small>(internal)</small></label><textarea id="order-notes" name="notes" rows="2" maxlength="2000"><%= orderPrefill.notes %></textarea></div>
      <div class="admin-subhead field-span-2"><h3>Garments in this order</h3><p>Each garment has an independent progress status. Add more rows if one customer order includes multiple garments.</p></div>
      <div class="garment-entry-list field-span-2" data-garment-rows>
        <div class="garment-entry-row" data-garment-row>
          <div class="form-field"><label>Garment type *</label><select name="garmentType" required><option value="">Choose garment</option><% garmentTypes.forEach((type) => { %><option value="<%= type %>"><%= type %></option><% }) %></select></div>
          <div class="form-field"><label>Quantity *</label><input type="number" name="quantity" value="1" min="1" max="100" required></div>
          <div class="form-field"><label>Description</label><input name="garmentDescription" maxlength="220" placeholder="e.g. navy two-piece suit"></div>
          <div class="form-field"><label>Fabric reference / interest</label><input name="fabricLabel" maxlength="180" placeholder="Fabric name or internal code"></div>
          <div class="form-field field-span-2"><label>Garment instructions</label><textarea name="instructions" rows="2" maxlength="1200" placeholder="Agreed design or tailoring notes. Do not store sensitive information here."></textarea></div>
          <button type="button" class="text-danger garment-remove" data-remove-garment hidden>Remove garment row</button>
        </div>
      </div>
      <div class="form-submit-row field-span-2"><button class="button button-outline" type="button" data-add-garment>+ Add another garment</button><button class="button button-dark" type="submit">Create Order & Job Card</button></div>
    </form>
  </div>

  <div class="admin-subhead order-list-heading"><h3>Orders</h3><p>Order history is retained. Archive completed orders to keep the active list focused; archiving does not delete records.</p></div>
  <% const visibleOrders = orders.filter((order) => !order.archived); %>
  <% if (visibleOrders.length) { %>
    <div class="admin-filter-row"><label for="orderSearch">Search orders</label><input id="orderSearch" type="search" placeholder="Reference, customer, garment…" data-list-filter="order-record"><label for="orderStatusFilter">Status</label><select id="orderStatusFilter" data-status-filter="order-record"><option value="">All active and completed</option><option value="in_progress">In progress</option><option value="fitting">Fitting</option><option value="alterations">Alterations / finishing</option><option value="ready_for_collection">Ready for collection</option><option value="collected">Collected</option><option value="cancelled">Cancelled</option></select></div>
    <div class="admin-record-list order-record-list">
    <% visibleOrders.forEach((order) => { const derivedStatus = order.status === 'cancelled' ? 'cancelled' : getOrderOverallStatusForTemplate(order); %>
      <article class="admin-record order-record" data-search="<%= `${order.reference} ${order.customerName} ${order.phone} ${order.garments.map((item) => `${item.type} ${item.description} ${item.fabricLabel}`).join(' ')}`.toLowerCase() %>" data-status="<%= derivedStatus %>">
        <div class="appointment-record-head"><div><span class="status-pill <%= ['collected','ready_for_collection'].includes(derivedStatus) ? 'status-live' : derivedStatus === 'cancelled' ? 'status-draft' : 'status-new' %>"><%= orderStatusLabel(order) %></span><h3><%= order.reference %> <span>·</span> <%= order.customerName %></h3><p><%= order.garments.length %> garment line(s) · Created <%= order.orderDate %><%= order.expectedCollectionDate ? ` · Expected collection ${order.expectedCollectionDate}` : ' · Collection date not set' %></p><small><%= order.phone || 'No phone recorded' %><%= order.email ? ` · ${order.email}` : '' %></small></div><div class="appointment-record-contact"><a class="button button-small button-outline" href="/admin/orders/<%= order.id %>/print" target="_blank" rel="noopener noreferrer">Print job card ↗</a></div></div>
        <div class="order-garments-list">
          <% order.garments.forEach((garment) => { %>
            <div class="order-garment-card"><div class="order-garment-heading"><div><span class="status-pill <%= ['collected','ready_for_collection'].includes(garment.status) ? 'status-live' : garment.status === 'cancelled' ? 'status-draft' : 'status-new' %>"><%= garmentStatusLabels[garment.status] || garment.status %></span><h4><%= garment.type %> <%= garment.description ? `· ${garment.description}` : '' %></h4><small>Quantity: <%= garment.quantity %><%= garment.fabricLabel ? ` · Fabric: ${garment.fabricLabel}` : '' %></small></div></div>
              <% if (garment.instructions) { %><p class="order-instructions"><%= garment.instructions %></p><% } %>
              <% const nextStatuses = garmentStatusTransitions[garment.status] || []; if (order.status !== 'cancelled' && nextStatuses.length) { %>
                <form action="/admin/orders/<%= order.id %>/garments/<%= garment.id %>/status" method="post" class="garment-status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="garment-status-<%= garment.id %>">Move to next stage</label><select id="garment-status-<%= garment.id %>" name="status"><% nextStatuses.forEach((status) => { %><option value="<%= status %>"><%= garmentStatusLabels[status] %></option><% }) %></select><input name="note" maxlength="800" placeholder="Optional internal note"><button type="submit" class="button button-small button-outline">Update</button></form>
              <% } %>
              <% if ((garment.statusHistory || []).length) { %><details class="status-history-details"><summary>Garment history (<%= garment.statusHistory.length %>)</summary><ol class="history-list"><% garment.statusHistory.slice().reverse().forEach((history) => { %><li><strong><%= garmentStatusLabels[history.status] || history.status %></strong><small><%= new Date(history.at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) %> · <%= history.by %></small><% if (history.note) { %><p><%= history.note %></p><% } %></li><% }) %></ol></details><% } %>
            </div>
          <% }) %>
        </div>
        <details class="admin-inline-edit"><summary>Edit order notes / collection date and view order history</summary><div class="admin-record-editor">
          <form action="/admin/orders/<%= order.id %>/update" method="post" class="admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label for="order-date-edit-<%= order.id %>">Expected collection date</label><input id="order-date-edit-<%= order.id %>" type="date" name="expectedCollectionDate" min="<%= todayKey %>" value="<%= order.expectedCollectionDate || '' %>"></div><div class="form-field field-span-2"><label for="order-notes-edit-<%= order.id %>">Internal order notes</label><textarea id="order-notes-edit-<%= order.id %>" name="notes" rows="3" maxlength="2000"><%= order.notes || '' %></textarea></div><div class="form-submit-row field-span-2"><p>Collection dates are estimates unless your store has confirmed them with the customer.</p><button type="submit" class="button button-small button-dark">Save Order Details</button></div></form>
          <% if ((order.statusHistory || []).length) { %><details class="status-history-details"><summary>Order history (<%= order.statusHistory.length %>)</summary><ol class="history-list"><% order.statusHistory.slice().reverse().forEach((history) => { %><li><strong><%= history.action.replace(/_/g, ' ') %></strong><small><%= new Date(history.at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) %> · <%= history.by %></small><% if (history.note) { %><p><%= history.note %></p><% } %></li><% }) %></ol></details><% } %>
        </div></details>
        <div class="order-record-actions">
          <% if (order.status !== 'cancelled' && !order.garments.some((item) => item.status === 'collected')) { %><form action="/admin/orders/<%= order.id %>/cancel" method="post" data-confirm="Cancel this order and mark all uncollected garments as cancelled?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="note" value="Cancelled from the administrator dashboard."><button class="text-danger" type="submit">Cancel order</button></form><% } %>
          <% if (['collected','cancelled'].includes(derivedStatus)) { %><form action="/admin/orders/<%= order.id %>/archive" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="archived" value="yes"><button class="button button-small button-outline" type="submit">Archive completed record</button></form><% } %>
        </div>
      </article>
    <% }) %>
    </div>
  <% } else { %><div class="admin-empty-state"><span>09</span><div><strong>No tailoring orders yet.</strong><p>Create an order above when a customer confirms tailoring details at the store.</p></div></div><% } %>

  <% if (archivedOrders.length) { %><details class="archived-orders"><summary>Archived orders (<%= archivedOrders.length %>)</summary><div class="admin-record-list"><% archivedOrders.forEach((order) => { %><article class="admin-simple-record"><div><strong><%= order.reference %> · <%= order.customerName %></strong><p><%= order.garments.length %> garment line(s) · <%= orderStatusLabel(order) %></p></div><div class="admin-simple-actions"><a class="button button-small button-outline" href="/admin/orders/<%= order.id %>/print" target="_blank" rel="noopener noreferrer">Print job card</a><form action="/admin/orders/<%= order.id %>/archive" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="archived" value="no"><button type="submit" class="button button-small button-outline">Restore</button></form></div></article><% }) %></div></details><% } %>
</section>
