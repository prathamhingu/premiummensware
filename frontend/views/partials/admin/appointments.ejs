<section class="admin-section" id="appointments">
  <div class="admin-section-head"><div><p class="admin-kicker">08 / CUSTOMER VISITS</p><h2>Appointment management</h2><p>Requests reserve a configured slot while pending. Confirm, reschedule, or reject a request only after checking the store's schedule.</p></div><span class="admin-section-badge"><%= appointments.filter((item) => ['pending', 'reschedule_requested'].includes(item.status)).length %> AWAITING ACTION</span></div>
  <div class="admin-stats admin-stats--compact">
    <div class="admin-stat"><span>PENDING</span><strong><%= appointments.filter((item) => item.status === 'pending').length %></strong><small>Require review</small></div>
    <div class="admin-stat"><span>CONFIRMED / RESCHEDULED</span><strong><%= appointments.filter((item) => ['confirmed', 'rescheduled'].includes(item.status)).length %></strong><small>Accepted store visits</small></div>
    <div class="admin-stat"><span>COMPLETED</span><strong><%= appointments.filter((item) => item.status === 'completed').length %></strong><small>Visit marked complete</small></div>
  </div>
  <div class="admin-create-panel">
    <h3>Configure appointment availability</h3>
    <p class="admin-help-note">The initial schedule is closed on every day until you save your real store hours below. Do not enable times the store cannot honour. Timezone: Asia/Kolkata.</p>
    <form action="/admin/appointments/settings" method="post" class="admin-form-grid appointment-settings-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="admin-subhead field-span-2"><h3>Weekly opening hours</h3><p>Untick a day's closed box only when appointments can genuinely be accepted that day.</p></div>
      <% dayKeys.forEach((day) => { const hours = appointmentSettings.weeklyHours[day]; %>
        <div class="appointment-day-row">
          <label class="appointment-day-name"><%= dayNames[day] %></label>
          <label class="check-field"><input type="checkbox" name="<%= day %>Closed" <%= hours.closed ? 'checked' : '' %>><span>Closed</span></label>
          <label>Opens<input name="<%= day %>Open" type="time" value="<%= hours.open %>" required></label>
          <label>Closes<input name="<%= day %>Close" type="time" value="<%= hours.close %>" required></label>
        </div>
      <% }) %>
      <div class="admin-subhead field-span-2"><h3>Booking rules</h3><p>These limits apply to all days unless a date exception changes the opening hours.</p></div>
      <div class="form-field"><label for="slotMinutes">Appointment slot duration</label><select id="slotMinutes" name="slotMinutes"><% [15,30,45,60].forEach((minutes) => { %><option value="<%= minutes %>" <%= appointmentSettings.slotMinutes === minutes ? 'selected' : '' %>><%= minutes %> minutes</option><% }) %></select></div>
      <div class="form-field"><label for="maxAppointmentsPerSlot">Maximum appointments per slot</label><select id="maxAppointmentsPerSlot" name="maxAppointmentsPerSlot"><% [1,2,3,4,5,6,7,8].forEach((count) => { %><option value="<%= count %>" <%= appointmentSettings.maxAppointmentsPerSlot === count ? 'selected' : '' %>><%= count %></option><% }) %></select><small>Use 1 for an exclusive consultation slot.</small></div>
      <div class="form-field"><label for="breakStart">Daily break starts <small>(optional)</small></label><input id="breakStart" name="breakStart" type="time" value="<%= appointmentSettings.breakStart %>"></div>
      <div class="form-field"><label for="breakEnd">Daily break ends <small>(optional)</small></label><input id="breakEnd" name="breakEnd" type="time" value="<%= appointmentSettings.breakEnd %>"></div>
      <div class="form-field"><label for="minAdvanceHours">Minimum advance notice (hours)</label><input id="minAdvanceHours" name="minAdvanceHours" type="number" min="0" max="168" value="<%= appointmentSettings.minAdvanceHours %>" required></div>
      <div class="form-field"><label for="maxAdvanceDays">Maximum advance booking (days)</label><input id="maxAdvanceDays" name="maxAdvanceDays" type="number" min="1" max="365" value="<%= appointmentSettings.maxAdvanceDays %>" required></div>
      <div class="form-field field-span-2"><label for="closedDatesText">Additional closed dates <small>(optional, one YYYY-MM-DD date per line)</small></label><textarea id="closedDatesText" name="closedDatesText" rows="3" placeholder="2026-12-25&#10;2027-01-01"><%= appointmentSettings.closedDates.join('\n') %></textarea></div>
      <div class="form-field field-span-2"><label for="exceptionsText">Opening-hour exceptions <small>(optional; one line per date)</small></label><textarea id="exceptionsText" name="exceptionsText" rows="4" placeholder="2026-12-24,10:00,14:00&#10;2026-12-25,closed"><%= appointmentSettings.exceptions.map((item) => item.closed ? `${item.date},closed` : `${item.date},${item.open},${item.close}`).join('\n') %></textarea><small>Format: <code>YYYY-MM-DD,closed</code> or <code>YYYY-MM-DD,HH:MM,HH:MM</code>. An exception overrides that day's weekly hours. A separately listed closed date takes priority.</small></div>
      <div class="form-submit-row field-span-2"><p>Pending requests reserve capacity until rejected/cancelled. Rescheduling releases the previous slot and checks the new one within a single locked operation.</p><button type="submit" class="button button-dark">Save Availability Settings</button></div>
    </form>
    <div class="notification-config-note <%= emailNotificationsConfigured ? 'is-ready' : '' %>"><strong>Email notifications: <%= emailNotificationsConfigured ? 'configured' : 'not configured' %></strong><p><%= emailNotificationsConfigured ? 'The Resend API settings are present. Failed email sends are logged and do not undo saved appointments.' : 'For email alerts, set RESEND_API_KEY, EMAIL_FROM, and NOTIFICATION_EMAIL_TO in .env, then restart the server. Appointment requests still work without email.' %></p></div>
  </div>

  <div class="admin-subhead appointment-list-heading"><h3>Appointment requests and visits</h3><p>All appointment records are private to this administrator area. Internal notes are never shown to customers.</p></div>
  <% if (appointments.length) { %>
    <div class="admin-filter-row"><label for="appointmentSearch">Search appointments</label><input id="appointmentSearch" type="search" placeholder="Reference, name, phone, service…" data-list-filter="appointment-record"><label for="appointmentStatusFilter">Status</label><select id="appointmentStatusFilter" data-status-filter="appointment-record"><option value="">All statuses</option><% Object.entries(appointmentStatusLabels).forEach(([status, label]) => { %><option value="<%= status %>"><%= label %></option><% }) %></select></div>
    <div class="admin-record-list">
      <% appointments.forEach((item) => { %>
        <article class="admin-record appointment-record" data-search="<%= `${item.reference} ${item.name} ${item.phone} ${item.service} ${item.date} ${item.time}`.toLowerCase() %>" data-status="<%= item.status %>">
          <div class="appointment-record-head"><div><span class="status-pill <%= ['confirmed','rescheduled','completed'].includes(item.status) ? 'status-live' : ['pending','reschedule_requested'].includes(item.status) ? 'status-new' : 'status-draft' %>"><%= appointmentStatusLabels[item.status] || item.status %></span><h3><%= item.reference %> <span>·</span> <%= item.name %></h3><p><strong><%= item.date %> at <%= item.time %></strong> · <%= item.service %></p><small>Requested <%= new Date(item.createdAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) %> · Asia/Kolkata</small></div><div class="appointment-record-contact"><a href="tel:<%= phoneDigits(item.phone) %>"><%= item.phone %></a><% if (item.email) { %><a href="mailto:<%= item.email %>"><%= item.email %></a><% } %><a href="https://wa.me/<%= item.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div></div>
          <div class="appointment-record-summary"><% if (item.occasion) { %><span><small>OCCASION</small><strong><%= item.occasion %></strong></span><% } %><% if (item.style) { %><span><small>STYLE DIRECTION</small><strong><%= item.style %></strong></span><% } %><% if (item.fabricLabel) { %><span><small>FABRIC INTEREST</small><strong><%= item.fabricLabel %></strong></span><% } %><% if (item.notes) { %><span><small>CUSTOMER NOTE</small><strong><%= item.notes %></strong></span><% } %></div>
          <details class="admin-inline-edit"><summary>Manage status, private notes, and history</summary><div class="admin-record-editor">
            <form action="/admin/appointments/<%= item.id %>/status" method="post" class="admin-form-grid appointment-action-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label for="appt-status-<%= item.id %>">Status</label><select id="appt-status-<%= item.id %>" name="status"><option value="<%= item.status %>" selected><%= appointmentStatusLabels[item.status] || item.status %> (keep current)</option><% (appointmentTransitions[item.status] || []).forEach((status) => { %><option value="<%= status %>"><%= appointmentStatusLabels[status] %></option><% }) %></select></div><div class="form-field field-span-2"><label for="appt-notes-<%= item.id %>">Private internal notes</label><textarea id="appt-notes-<%= item.id %>" name="internalNotes" rows="2" maxlength="1500"><%= item.internalNotes || '' %></textarea></div><div class="form-submit-row field-span-2"><p>Changing status adds a history entry. Status transitions that are not allowed by the workflow are rejected.</p><button class="button button-small button-dark" type="submit">Save appointment</button></div></form>
            <% if (['pending','confirmed','reschedule_requested','rescheduled'].includes(item.status)) { %>
              <form action="/admin/appointments/<%= item.id %>/reschedule" method="post" class="admin-form-grid appointment-reschedule-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="admin-subhead field-span-2"><h3>Reschedule appointment</h3><p>The new slot is checked against current availability before it is saved.</p></div><div class="form-field"><label for="appt-date-<%= item.id %>">New date</label><input id="appt-date-<%= item.id %>" type="date" name="date" min="<%= todayKey %>" required></div><div class="form-field"><label for="appt-time-<%= item.id %>">New start time</label><input id="appt-time-<%= item.id %>" type="time" name="time" required></div><div class="form-field field-span-2"><label for="appt-reschedule-note-<%= item.id %>">Reschedule note <small>(optional, private)</small></label><input id="appt-reschedule-note-<%= item.id %>" name="note" maxlength="500"></div><div class="form-submit-row field-span-2"><p>Save only after agreeing the new time with the customer.</p><button class="button button-small button-outline" type="submit">Save New Time</button></div></form>
            <% } %>
            <details class="status-history-details"><summary>View status history (<%= (item.statusHistory || []).length %>)</summary><ol class="history-list"><% (item.statusHistory || []).slice().reverse().forEach((history) => { %><li><strong><%= appointmentStatusLabels[history.status] || history.status %></strong><small><%= new Date(history.at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) %> · <%= history.by %></small><% if (history.note) { %><p><%= history.note %></p><% } %></li><% }) %></ol></details>
            <div class="appointment-record-footer"><a class="button button-small button-gold" href="/admin/dashboard?fromAppointment=<%= encodeURIComponent(item.id) %>#orders">Create tailoring order from this appointment ↗</a></div>
          </div></details>
        </article>
      <% }) %>
    </div>
  <% } else { %><div class="admin-empty-state"><span>08</span><div><strong>No appointment requests yet.</strong><p>Configure the weekly hours above. Customers can then request a time from the public Appointments page.</p><a href="/appointments" target="_blank" rel="noopener noreferrer">Preview customer appointment page ↗</a></div></div><% } %>
</section>
