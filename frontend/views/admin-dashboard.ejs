<%- include('partials/head', { pageTitle, isAdminPage: true }) %>
<div class="admin-app">
  <aside class="admin-sidebar">
    <a href="/admin/dashboard" class="admin-sidebar-brand"><span class="brand-mark">M<span>.</span></span><span><strong><%= settings.businessName %></strong><small>WEBSITE CONTROL</small></span></a>
    <p class="admin-sidebar-label">CONTENT</p>
    <a href="#overview" class="admin-side-link is-current">Overview</a>
    <a href="#store-settings" class="admin-side-link">Store & Homepage</a>
    <a href="#categories" class="admin-side-link">Categories</a>
    <a href="#collections" class="admin-side-link">Collection entries</a>
    <a href="#gallery" class="admin-side-link">Gallery</a>
    <a href="#announcements" class="admin-side-link">Announcements</a>
    <a href="#testimonials" class="admin-side-link">Testimonials</a>
    <a href="#enquiries" class="admin-side-link">Enquiry inbox <span class="side-count"><%= enquiries.filter((item) => !item.read).length %></span></a>
    <p class="admin-sidebar-label">WORKROOM</p>
    <a href="#appointments" class="admin-side-link">Appointments <span class="side-count"><%= appointments.filter((item) => ['pending', 'reschedule_requested'].includes(item.status)).length %></span></a>
    <a href="#orders" class="admin-side-link">Tailoring orders <span class="side-count"><%= orders.filter((order) => !order.archived && order.status !== 'cancelled').length %></span></a>
    <div class="admin-sidebar-bottom"><a href="/" target="_blank" rel="noopener noreferrer">View public website ↗</a><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Sign out <span>↗</span></button></form></div>
  </aside>

  <main class="admin-main" id="overview">
    <header class="admin-topbar"><div><span class="admin-topbar-kicker">WEBSITE MANAGEMENT</span><h1>Good day, <em><%= adminUsername %>.</em></h1><p>Keep the details fresh. The public website updates from the content you save here.</p></div><a href="/" class="button button-outline" target="_blank" rel="noopener noreferrer">Preview website ↗</a></header>
    <% if (flash) { %><div class="flash-message flash-<%= flash.kind === 'error' ? 'error' : 'success' %>" role="status"><%= flash.message %></div><% } %>

    <div class="admin-stats"><div class="admin-stat"><span>COLLECTION ENTRIES</span><strong><%= collections.length %></strong><small>Published public collection items</small></div><div class="admin-stat"><span>GALLERY PHOTOS</span><strong><%= gallery.length %></strong><small>Store-uploaded photographs</small></div><div class="admin-stat"><span>NEW ENQUIRIES</span><strong><%= enquiries.filter((item) => !item.read).length %></strong><small>Waiting for your review</small></div><div class="admin-stat"><span>ACTIVE ANNOUNCEMENTS</span><strong><%= announcements.filter((item) => item.active).length %></strong><small>Visible on the homepage</small></div></div>

    <section class="admin-section" id="store-settings"><div class="admin-section-head"><div><p class="admin-kicker">01 / FOUNDATION</p><h2>Store & homepage settings</h2><p>These details appear throughout the public website. Replace the placeholders before launch.</p></div><span class="admin-section-badge">PUBLIC CONTENT</span></div>
      <form action="/admin/settings" method="post" enctype="multipart/form-data" class="admin-form-grid">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-field"><label for="businessName">Business name *</label><input id="businessName" name="businessName" type="text" value="<%= settings.businessName %>" required maxlength="100"></div>
        <div class="form-field"><label for="tagline">Short brand line</label><input id="tagline" name="tagline" type="text" value="<%= settings.tagline %>" maxlength="150" placeholder="MEN'S FABRICS · TAILORING · SUITING"></div>
        <div class="form-field field-span-2"><label for="intro">Business introduction</label><textarea id="intro" name="intro" rows="2" maxlength="500"><%= settings.intro %></textarea></div>
        <div class="form-field"><label for="heroHeadline">Homepage headline</label><input id="heroHeadline" name="heroHeadline" type="text" value="<%= settings.heroHeadline %>" maxlength="150"></div>
        <div class="form-field"><label for="heroSubheadline">Homepage supporting text</label><input id="heroSubheadline" name="heroSubheadline" type="text" value="<%= settings.heroSubheadline %>" maxlength="400"></div>
        <div class="form-field field-span-2"><label for="heroImageUrl">Hero image URL (optional fallback)</label><input id="heroImageUrl" name="heroImageUrl" type="url" value="<%= settings.heroImageUrl %>" maxlength="700" placeholder="https://..."><small>Use a direct image URL. Uploading a hero image below takes priority.</small></div>
        <div class="form-field field-span-2"><label for="heroImage">Upload or replace homepage hero image</label><input id="heroImage" name="heroImage" type="file" accept="image/jpeg,image/png,image/webp,image/avif"><small>JPG, PNG, WEBP, or AVIF. Maximum 5 MB. Use a photo you own or have permission to use.</small><% if (settings.heroImage) { %><div class="current-image-line"><img src="<%= settings.heroImage %>" alt="Current homepage hero"><span>Current uploaded hero image</span></div><label class="check-field"><input type="checkbox" name="removeHeroImage"><span>Remove the uploaded hero and use the fallback image URL instead</span></label><% } %></div>
        <div class="admin-subhead field-span-2"><h3>Contact details</h3><p>These power the call, WhatsApp, address, and directions links on the public site.</p></div>
        <div class="form-field"><label for="phone">Phone number</label><input id="phone" name="phone" type="tel" value="<%= settings.phone %>" maxlength="40" placeholder="Include country code where appropriate"></div>
        <div class="form-field"><label for="whatsapp">WhatsApp number</label><input id="whatsapp" name="whatsapp" type="tel" value="<%= settings.whatsapp %>" maxlength="40" placeholder="Digits with country code, e.g. 91... "><small>WhatsApp links use the country code and digits.</small></div>
        <div class="form-field"><label for="email">Business email</label><input id="email" name="email" type="email" value="<%= settings.email %>" maxlength="160"></div>
        <div class="form-field"><label for="openingHours">Regular opening hours</label><input id="openingHours" name="openingHours" type="text" value="<%= settings.openingHours %>" maxlength="300" placeholder="e.g. Mon–Sat: 10:00 AM–8:00 PM"><small>Publicly displayed as the regular schedule, not proof of live open/closed status.</small></div>
        <div class="admin-subhead field-span-2"><h3>Call before you travel</h3><p>Set a manually verified store status for a specific date. If the date has passed or does not match today, the website falls back to “Call to confirm” rather than pretending it knows the store is open.</p></div>
        <div class="form-field"><label for="dailyStoreStatusDate">Status date</label><input id="dailyStoreStatusDate" name="dailyStoreStatusDate" type="date" value="<%= settings.dailyStoreStatusDate || todayKey %>" required><small>For today’s message, leave this as today. Future and one-off dates can also be listed below.</small></div>
        <div class="form-field"><label for="dailyStoreStatus">Store status for that date</label><select id="dailyStoreStatus" name="dailyStoreStatus"><% Object.entries(storeStatusOptions).forEach(([value, label]) => { %><option value="<%= value %>" <%= (settings.dailyStoreStatus || 'call_to_confirm') === value ? 'selected' : '' %>><%= label %></option><% }) %></select></div>
        <div class="form-field"><label for="dailyStoreSpecialHours">Special hours (optional)</label><input id="dailyStoreSpecialHours" name="dailyStoreSpecialHours" type="text" value="<%= settings.dailyStoreSpecialHours || '' %>" maxlength="160" placeholder="e.g. 12:00 PM–5:00 PM"></div>
        <div class="form-field"><label for="dailyStoreStatusNote">Public status note (optional)</label><input id="dailyStoreStatusNote" name="dailyStoreStatusNote" type="text" value="<%= settings.dailyStoreStatusNote || '' %>" maxlength="300" placeholder="e.g. Please call before travelling today"></div>
        <div class="form-field field-span-2"><label for="storeExceptionsText">Other date-specific exceptions</label><textarea id="storeExceptionsText" name="storeExceptionsText" rows="4" maxlength="20000" placeholder="YYYY-MM-DD | status | special hours (optional) | public note (optional)"><%= storeExceptionsText || '' %></textarea><small>One entry per line: YYYY-MM-DD | status | special hours (optional) | public note (optional). Status values: open_as_usual, open_changed_hours, closed_today, call_to_confirm. A matching date overrides the daily status above. Keep customer/private notes out of this field.</small></div>
        <div class="form-field field-span-2 store-status-admin-note"><p><strong>Important:</strong> “Open as usual” is a manual notice, not a live sensor. Customers are still encouraged to call and reconfirm before travelling. Fabric availability is separate and must be confirmed directly with the store.</p></div>
        <div class="form-field field-span-2"><label for="address">Full store address</label><textarea id="address" name="address" rows="2" maxlength="300" placeholder="Shop / building, street, area, city, state, PIN code"><%= settings.address %></textarea></div>
        <div class="form-field field-span-2"><label for="mapUrl">Google Maps directions URL</label><input id="mapUrl" name="mapUrl" type="url" value="<%= settings.mapUrl %>" maxlength="500" placeholder="https://maps.google.com/..."><small>Can be a Google Maps share link. If blank, directions are generated from the address.</small></div>
        <div class="form-field field-span-2"><label for="mapEmbedUrl">Google Maps embed URL (optional)</label><input id="mapEmbedUrl" name="mapEmbedUrl" type="url" value="<%= settings.mapEmbedUrl %>" maxlength="700" placeholder="https://www.google.com/maps/embed?pb=..."><small>Use the embed URL from Google Maps, not the regular share link.</small></div>
        <div class="form-field"><label for="instagramUrl">Instagram URL</label><input id="instagramUrl" name="instagramUrl" type="url" value="<%= settings.instagramUrl %>" maxlength="300" placeholder="https://instagram.com/..."></div>
        <div class="form-field"><label for="facebookUrl">Facebook URL</label><input id="facebookUrl" name="facebookUrl" type="url" value="<%= settings.facebookUrl %>" maxlength="300" placeholder="https://facebook.com/..."></div>
        <div class="admin-subhead field-span-2"><h3>Announcement strip</h3><p>Optional short notice shown at the top of public pages.</p></div>
        <div class="form-field field-span-2"><label for="announcementBar">Announcement text</label><input id="announcementBar" name="announcementBar" type="text" value="<%= settings.announcementBar %>" maxlength="220" placeholder="A seasonal notice or store update"></div>
        <label class="check-field field-span-2"><input type="checkbox" name="announcementBarActive" <%= settings.announcementBarActive ? 'checked' : '' %>><span>Show announcement strip on the website</span></label>
        <div class="form-submit-row field-span-2"><p>Check spelling and contact details before saving. No contact details are invented by the website.</p><button type="submit" class="button button-dark">Save store settings ↗</button></div>
      </form>
    </section>

    <section class="admin-section" id="categories"><div class="admin-section-head"><div><p class="admin-kicker">02 / ORGANIZE</p><h2>Collection categories</h2><p>Create and update fabric categories shown across the website.</p></div><span class="admin-section-badge"><%= categories.length %> CATEGORIES</span></div>
      <div class="admin-create-panel"><h3>Add a category</h3><form action="/admin/categories" method="post" enctype="multipart/form-data" class="admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label>Category name *</label><input name="name" required maxlength="100" placeholder="e.g. Occasionwear Fabrics"></div><div class="form-field"><label>Image URL (optional)</label><input name="imageUrl" type="url" maxlength="700" placeholder="https://..."></div><div class="form-field field-span-2"><label>Description</label><textarea name="description" rows="2" maxlength="500" placeholder="Describe this category without claiming unconfirmed stock or specifications."></textarea></div><div class="form-field field-span-2"><label>Upload category image (optional)</label><input name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif"></div><div class="form-submit-row field-span-2"><p>New categories become available in collection filters and item forms.</p><button class="button button-dark" type="submit">Add category +</button></div></form></div>
      <div class="admin-record-list"><% categories.forEach((item) => { %><details class="admin-record"><summary><span class="admin-record-thumb"><% if (imageFor(item)) { %><img src="<%= imageFor(item) %>" alt=""><% } else { %>M.<% } %></span><span class="admin-record-main"><strong><%= item.name %></strong><small>/<%= item.slug %></small></span><span class="record-action">Edit details⌄</span></summary><div class="admin-record-editor"><form action="/admin/categories/<%= item.id %>/update" method="post" enctype="multipart/form-data" class="admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label>Name</label><input name="name" value="<%= item.name %>" required maxlength="100"></div><div class="form-field"><label>Image URL fallback</label><input name="imageUrl" type="url" value="<%= item.imageUrl || '' %>" maxlength="700"></div><div class="form-field field-span-2"><label>Description</label><textarea name="description" rows="2" maxlength="500"><%= item.description || '' %></textarea></div><div class="form-field field-span-2"><label>Replace image (optional)</label><input name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif"></div><div class="form-submit-row field-span-2"><button class="button button-small button-dark" type="submit">Save category</button></div></form><form action="/admin/categories/<%= item.id %>/delete" method="post" class="inline-delete-form" data-confirm="Delete this category? Categories with collection entries cannot be deleted."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger" type="submit">Delete category</button></form></div></details><% }) %></div>
    </section>

    <section class="admin-section" id="collections"><div class="admin-section-head"><div><p class="admin-kicker">03 / SHOWCASE</p><h2>Collection entries</h2><p>Add real items or collection highlights. Do not add prices or specifications unless confirmed.</p></div><span class="admin-section-badge"><%= collections.length %> ENTRIES</span></div>
      <div class="admin-create-panel"><h3>Add a collection entry</h3><form action="/admin/collections" method="post" enctype="multipart/form-data" class="admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label>Title *</label><input name="title" required maxlength="120" placeholder="e.g. Navy suiting selection"></div><div class="form-field"><label>Category *</label><select name="categoryId" required><option value="">Choose category</option><% categories.forEach((cat) => { %><option value="<%= cat.id %>"><%= cat.name %></option><% }) %></select></div><div class="form-field field-span-2"><label>Description</label><textarea name="description" rows="2" maxlength="700" placeholder="Describe the item or category in accurate terms."></textarea></div><div class="form-field"><label>Upload image</label><input name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif"></div><div class="form-field"><label>Or image URL</label><input name="imageUrl" type="url" maxlength="700" placeholder="https://..."></div><label class="check-field field-span-2"><input type="checkbox" name="featured"><span>Feature this item on the homepage</span></label><div class="form-field"><label>Public availability message</label><select name="availability"><option value="call_to_confirm" selected>Please call to confirm</option><option value="confirmed">Last confirmed by the store</option><option value="unavailable">Temporarily unavailable</option></select></div><div class="form-field"><label>Display order</label><input name="sortOrder" type="number" min="0" max="9999" value="<%= collections.length + 1 %>"></div><label class="check-field field-span-2"><input type="checkbox" name="published" checked><span>Publish this entry on the public website</span></label><div class="form-submit-row field-span-2"><p>An image is required. Maximum upload size: 5 MB.</p><button class="button button-dark" type="submit">Add collection entry +</button></div></form></div>
      <% if (collections.length) { %><div class="admin-record-list"><% collections.forEach((item) => { %><details class="admin-record"><summary><span class="admin-record-thumb"><% if (imageFor(item)) { %><img src="<%= imageFor(item) %>" alt=""><% } else { %>M.<% } %></span><span class="admin-record-main"><strong><%= item.title %></strong><small><%= (categories.find((cat) => cat.id === item.categoryId) || {}).name || 'Uncategorized' %><%= item.featured ? ' · Featured' : '' %></small></span><span class="record-action">Edit details⌄</span></summary><div class="admin-record-editor"><form action="/admin/collections/<%= item.id %>/update" method="post" enctype="multipart/form-data" class="admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label>Title</label><input name="title" value="<%= item.title %>" required maxlength="120"></div><div class="form-field"><label>Category</label><select name="categoryId" required><% categories.forEach((cat) => { %><option value="<%= cat.id %>" <%= cat.id === item.categoryId ? 'selected' : '' %>><%= cat.name %></option><% }) %></select></div><div class="form-field field-span-2"><label>Description</label><textarea name="description" rows="2" maxlength="700"><%= item.description || '' %></textarea></div><div class="form-field"><label>Image URL fallback</label><input name="imageUrl" type="url" value="<%= item.imageUrl || '' %>" maxlength="700"></div><div class="form-field"><label>Replace image (optional)</label><input name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif"></div><label class="check-field field-span-2"><input type="checkbox" name="featured" <%= item.featured ? 'checked' : '' %>><span>Feature on homepage</span></label><div class="form-field"><label>Public availability message</label><select name="availability"><option value="call_to_confirm" <%= (!item.availability || item.availability === 'call_to_confirm') ? 'selected' : '' %>>Please call to confirm</option><option value="confirmed" <%= item.availability === 'confirmed' ? 'selected' : '' %>>Last confirmed by the store</option><option value="unavailable" <%= item.availability === 'unavailable' ? 'selected' : '' %>>Temporarily unavailable</option></select></div><div class="form-field"><label>Display order</label><input name="sortOrder" type="number" min="0" max="9999" value="<%= Number.isFinite(Number(item.sortOrder)) ? item.sortOrder : 0 %>"></div><label class="check-field field-span-2"><input type="checkbox" name="published" <%= item.published !== false ? 'checked' : '' %>><span>Publish this entry on the public website</span></label><div class="form-submit-row field-span-2"><button class="button button-small button-dark" type="submit">Save entry</button></div></form><form action="/admin/collections/<%= item.id %>/delete" method="post" class="inline-delete-form" data-confirm="Permanently delete this collection entry?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger" type="submit">Delete entry</button></form></div></details><% }) %></div><% } else { %><div class="admin-empty-state"><span>01</span><div><strong>No collection entries yet.</strong><p>Add real collection items above. The public pages will show the relevant category introduction until you add entries.</p></div></div><% } %>
    </section>

    <section class="admin-section" id="gallery"><div class="admin-section-head"><div><p class="admin-kicker">04 / VISUAL STORY</p><h2>Gallery photographs</h2><p>Upload genuine photos of your store, available fabrics, tailoring work, or finished garments.</p></div><span class="admin-section-badge"><%= gallery.length %> PHOTOS</span></div>
      <div class="admin-create-panel"><h3>Upload a gallery image</h3><form action="/admin/gallery" method="post" enctype="multipart/form-data" class="admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label>Image title *</label><input name="title" required maxlength="120" placeholder="e.g. Suiting fabric display"></div><div class="form-field"><label>Category</label><select name="category"><option>Craftsmanship</option><option>Suiting</option><option>Fabrics</option><option>Shirting</option><option>Trousers</option><option>Jabbha</option><option>Store interior</option><option>Finished garment</option></select></div><div class="form-field field-span-2"><label>Accessible image description (alt text)</label><input name="alt" maxlength="180" placeholder="Describe the image for visitors using screen readers"></div><div class="form-field field-span-2"><label>Image file *</label><input name="image" type="file" required accept="image/jpeg,image/png,image/webp,image/avif"></div><div class="form-field"><label>Display order</label><input name="sortOrder" type="number" min="0" max="9999" value="<%= gallery.length + 1 %>"></div><label class="check-field"><input type="checkbox" name="featured"><span>Feature on homepage</span></label><label class="check-field field-span-2"><input type="checkbox" name="published" checked><span>Publish on the public gallery</span></label><div class="form-submit-row field-span-2"><p>JPG, PNG, WEBP, or AVIF, maximum 5 MB per image.</p><button class="button button-dark" type="submit">Upload photograph +</button></div></form></div>
      <% if (gallery.length) { %><div class="admin-gallery-grid"><% gallery.forEach((item) => { %><details class="admin-gallery-card"><summary><img src="<%= imageFor(item) %>" alt=""><span><strong><%= item.title %></strong><small><%= item.category %></small></span></summary><div class="admin-gallery-editor"><form action="/admin/gallery/<%= item.id %>/update" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Title<input name="title" value="<%= item.title %>" maxlength="120" required></label><label>Category<input name="category" value="<%= item.category %>" maxlength="80"></label><label>Alt text<input name="alt" value="<%= item.alt || '' %>" maxlength="180"></label><label>Replace image<input name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif"></label><label>Display order<input name="sortOrder" type="number" min="0" max="9999" value="<%= Number.isFinite(Number(item.sortOrder)) ? item.sortOrder : 0 %>"></label><label class="admin-inline-check"><input type="checkbox" name="featured" <%= item.featured ? 'checked' : '' %>> Featured on homepage</label><label class="admin-inline-check"><input type="checkbox" name="published" <%= item.published !== false ? 'checked' : '' %>> Published publicly</label><button class="button button-small button-dark" type="submit">Save</button></form><form action="/admin/gallery/<%= item.id %>/delete" method="post" data-confirm="Delete this gallery image?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="text-danger">Delete image</button></form></div></details><% }) %></div><% } else { %><div class="admin-empty-state"><span>02</span><div><strong>Your gallery is waiting for real photographs.</strong><p>Upload a few clear photos of fabrics, finished garments, work details, and the store interior. These help visitors know what to expect.</p></div></div><% } %>
    </section>

    <section class="admin-section" id="announcements"><div class="admin-section-head"><div><p class="admin-kicker">05 / STORE UPDATES</p><h2>Promotional announcements</h2><p>Use these for genuine updates. Active announcements appear on the homepage.</p></div><span class="admin-section-badge"><%= announcements.filter((item) => item.active).length %> ACTIVE</span></div>
      <div class="admin-create-panel"><h3>Create an announcement</h3><form action="/admin/announcements" method="post" class="admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label>Title *</label><input name="title" required maxlength="120" placeholder="e.g. Store timing update"></div><div class="form-field"><label>Supporting text</label><input name="body" maxlength="500" placeholder="Short, accurate explanation"></div><label class="check-field field-span-2"><input type="checkbox" name="active"><span>Publish on homepage immediately</span></label><div class="form-submit-row field-span-2"><p>Do not use fabricated discounts, expiry dates, or limited-stock claims.</p><button class="button button-dark" type="submit">Save announcement +</button></div></form></div>
      <% if (announcements.length) { %><div class="admin-record-list"><% announcements.forEach((item) => { %><div class="admin-simple-record"><div><strong><%= item.title %></strong><p><%= item.body || 'No supporting text.' %></p><span class="status-pill <%= item.active ? 'status-live' : 'status-draft' %>"><%= item.active ? 'Live on website' : 'Not published' %></span><details class="admin-inline-edit"><summary>Edit announcement details</summary><form action="/admin/announcements/<%= item.id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Title<input name="title" value="<%= item.title %>" required maxlength="120"></label><label>Supporting text<input name="body" value="<%= item.body || '' %>" maxlength="500"></label><label class="check-field"><input type="checkbox" name="active" <%= item.active ? 'checked' : '' %>><span>Publish on homepage</span></label><button class="button button-small button-dark" type="submit">Save changes</button></form></details></div><div class="admin-simple-actions"><form action="/admin/announcements/<%= item.id %>/toggle" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-outline" type="submit"><%= item.active ? 'Unpublish' : 'Publish' %></button></form><form action="/admin/announcements/<%= item.id %>/delete" method="post" data-confirm="Delete this announcement?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger" type="submit">Delete</button></form></div></div><% }) %></div><% } else { %><div class="admin-empty-state"><span>03</span><div><strong>No announcements yet.</strong><p>This section is optional. Leave it empty until you have a genuine update to share.</p></div></div><% } %>
    </section>

    <section class="admin-section" id="testimonials"><div class="admin-section-head"><div><p class="admin-kicker">06 / TRUST</p><h2>Customer testimonials</h2><p>Only publish genuine feedback after confirming the customer's permission to display it.</p></div><span class="admin-section-badge"><%= testimonials.filter((item) => item.published).length %> PUBLISHED</span></div>
      <div class="admin-create-panel"><h3>Add a testimonial</h3><form action="/admin/testimonials" method="post" class="admin-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-field"><label>Customer name / approved attribution *</label><input name="customerName" required maxlength="100" placeholder="Name or approved anonymous attribution"></div><div class="form-field"><label>Context</label><input name="context" maxlength="120" placeholder="e.g. Suiting customer"></div><div class="form-field field-span-2"><label>Exact customer feedback *</label><textarea name="quote" required rows="3" minlength="10" maxlength="600" placeholder="Use the customer's real words with their permission."></textarea></div><label class="check-field field-span-2"><input type="checkbox" name="permissionConfirmed"><span>I have permission to publish this testimonial and attribution.</span></label><label class="check-field field-span-2"><input type="checkbox" name="published"><span>Publish immediately (only works when permission is confirmed)</span></label><div class="form-submit-row field-span-2"><p>No sample or invented testimonials are inserted automatically.</p><button class="button button-dark" type="submit">Save testimonial +</button></div></form></div>
      <% if (testimonials.length) { %><div class="admin-record-list"><% testimonials.forEach((item) => { %><div class="admin-simple-record"><div><strong><%= item.customerName %></strong><p class="testimonial-admin-quote">“<%= item.quote %>”</p><small><%= item.context || 'Customer feedback' %></small><div class="status-row"><span class="status-pill <%= item.published ? 'status-live' : 'status-draft' %>"><%= item.published ? 'Published' : 'Draft' %></span><span class="status-pill <%= item.permissionConfirmed ? 'status-live' : 'status-draft' %>"><%= item.permissionConfirmed ? 'Permission confirmed' : 'Permission not confirmed' %></span></div><details class="admin-inline-edit"><summary>Edit testimonial details</summary><form action="/admin/testimonials/<%= item.id %>/update" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Customer name / approved attribution<input name="customerName" value="<%= item.customerName %>" required maxlength="100"></label><label>Context<input name="context" value="<%= item.context || '' %>" maxlength="120"></label><label>Exact customer feedback<textarea name="quote" rows="3" required minlength="10" maxlength="600"><%= item.quote %></textarea></label><label class="check-field"><input type="checkbox" name="permissionConfirmed" <%= item.permissionConfirmed ? 'checked' : '' %>><span>Customer permission confirmed</span></label><label class="check-field"><input type="checkbox" name="published" <%= item.published ? 'checked' : '' %>><span>Publish on public website</span></label><button class="button button-small button-dark" type="submit">Save changes</button></form></details></div><div class="admin-simple-actions"><form action="/admin/testimonials/<%= item.id %>/toggle" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-outline" type="submit"><%= item.published ? 'Unpublish' : 'Publish' %></button></form><form action="/admin/testimonials/<%= item.id %>/delete" method="post" data-confirm="Delete this testimonial?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger" type="submit">Delete</button></form></div></div><% }) %></div><% } %>
    </section>

    <section class="admin-section" id="enquiries"><div class="admin-section-head"><div><p class="admin-kicker">07 / CUSTOMER CARE</p><h2>Enquiry inbox</h2><p>Website form submissions are saved here. This version does not send email notifications automatically.</p></div><span class="admin-section-badge"><%= enquiries.length %> TOTAL</span></div>
      <% if (enquiries.length) { %><div class="enquiry-admin-list"><% enquiries.forEach((item) => { %><article class="enquiry-admin-card <%= item.read ? 'is-read' : 'is-new' %>"><div class="enquiry-admin-top"><div><span class="status-pill <%= item.read ? 'status-draft' : 'status-new' %>"><%= item.read ? 'Reviewed' : 'New enquiry' %></span><h3><%= item.name %></h3><small><%= new Date(item.createdAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %></small></div><div class="enquiry-admin-actions"><form action="/admin/enquiries/<%= item.id %>/toggle" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-outline" type="submit"><%= item.read ? 'Mark new' : 'Mark reviewed' %></button></form><form action="/admin/enquiries/<%= item.id %>/delete" method="post" data-confirm="Permanently delete this enquiry?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-danger" type="submit">Delete</button></form></div></div><div class="enquiry-admin-meta"><span><small>PHONE</small><a href="tel:<%= phoneDigits(item.phone) %>"><%= item.phone %></a></span><% if (item.email) { %><span><small>EMAIL</small><a href="mailto:<%= item.email %>"><%= item.email %></a></span><% } %><% if (item.subject) { %><span><small>TOPIC</small><strong><%= item.subject %></strong></span><% } %></div><p class="enquiry-admin-message"><%= item.message %></p><div class="enquiry-admin-bottom"><a class="text-link" href="/admin/dashboard?fromEnquiry=<%= encodeURIComponent(item.id) %>#orders">Create tailoring order ↗</a><a class="text-link" href="https://wa.me/<%= item.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener noreferrer">Open WhatsApp ↗</a><% if (item.email) { %><a class="text-link" href="mailto:<%= item.email %>?subject=<%= encodeURIComponent(`Regarding your enquiry to ${settings.businessName}`) %>">Reply by email ↗</a><% } %></div></article><% }) %></div><% } else { %><div class="admin-empty-state"><span>04</span><div><strong>No enquiries have come in yet.</strong><p>When a visitor submits the public contact form, the enquiry appears here for review.</p></div></div><% } %>
    </section>

    <%- include('partials/admin/appointments') %>
    <%- include('partials/admin/orders') %>

    <footer class="admin-footer"><span>Website content is stored locally; appointments and orders use separate locked JSON records.</span><a href="/" target="_blank" rel="noopener noreferrer">Open public website ↗</a></footer>
  </main>
</div>
<script src="/js/admin.js" defer></script>
</body>
</html>
