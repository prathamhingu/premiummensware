<%- include('partials/head') %>
<%- include('partials/nav', { activePage }) %>
<main>
  <section class="page-hero page-hero-paper collection-hero"><div class="container page-hero__inner"><p class="eyebrow"><span class="eyebrow-line"></span> FABRICS & COLLECTIONS</p><h1>Find the fabric.<br><em>Imagine the possibilities.</em></h1><p>Explore the categories, save the details that interest you, then visit the store to see current designs, feel the fabric, and discuss your garment.</p><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Collections</span></div><div class="collection-hero__actions"><% if (settings.phone && phoneDigits(settings.phone)) { %><a class="button button-gold" href="tel:<%= phoneDigits(settings.phone) %>">Call to Check Availability <span aria-hidden="true">↗</span></a><% } else { %><a class="button button-gold" href="/contact#contact-details">Contact the Store <span aria-hidden="true">↗</span></a><% } %><a class="button button-outline" href="/contact#contact-details">Visit Information <span aria-hidden="true">↗</span></a></div></div><div class="page-hero__image"><img src="<%= stockImages.detail %>" alt="Editorial fabric texture inspiration" fetchpriority="high"></div></section>
  <section class="section"><div class="container">
    <div class="collection-intro-row"><div><p class="eyebrow"><span class="eyebrow-line"></span> BROWSE BY CATEGORY</p><h2>Made for the way <em>you dress.</em></h2></div><p class="muted-copy">Fabric designs and availability change. Editorial images illustrate a style direction and are not a guarantee of current stock.</p></div>
    <div class="collection-explorer" data-collection-explorer>
      <div class="collection-explorer__search"><label for="collection-search">Find a collection</label><div class="collection-search-wrap"><span aria-hidden="true">⌕</span><input id="collection-search" type="search" placeholder="Search fabrics, categories, or descriptions" autocomplete="off" data-collection-search></div><p>Search this page's published collection entries.</p></div>
      <div class="filter-pills" aria-label="Filter collections by category"><a class="filter-pill <%= !selectedCategory ? 'is-active' : '' %>" href="/collections" data-category-filter="all">All categories</a><% categories.forEach((category) => { %><a class="filter-pill <%= selectedCategory && selectedCategory.id === category.id ? 'is-active' : '' %>" href="/collections?category=<%= encodeURIComponent(category.id) %>" data-category-filter="<%= category.id %>"><%= category.name %></a><% }) %></div>
    </div>
    <% if (collections.length) { %>
      <div class="collection-item-grid collection-item-grid--editorial" data-collection-grid><% collections.forEach((item, index) => { const cat = categories.find((entry) => entry.id === item.categoryId); const availability = ['confirmed', 'unavailable'].includes(item.availability) ? item.availability : 'call_to_confirm'; const searchable = [item.title, cat ? cat.name : '', item.description || ''].join(' ').toLowerCase(); %><article class="collection-item collection-item--premium" data-collection-card data-category-id="<%= item.categoryId %>" data-search-text="<%= searchable %>" <%= selectedCategory && selectedCategory.id !== item.categoryId ? 'hidden' : '' %>><div class="collection-item__image"><img src="<%= imageFor(item) || (cat && imageFor(cat)) || stockImages.detail %>" alt="Editorial image for <%= item.title %>" loading="lazy"><span class="collection-card-index">/<%= String(index + 1).padStart(2, '0') %></span><% if (item.featured) { %><span class="collection-badge">Featured selection</span><% } %></div><div class="collection-item__body"><p class="eyebrow"><%= cat ? cat.name : 'Collection' %></p><h3><%= item.title %></h3><p><%= item.description %></p><p class="collection-availability collection-availability--<%= availability %>"><span aria-hidden="true"></span><%= availability === 'confirmed' ? 'Availability last confirmed by the store. Please call ahead to reconfirm.' : availability === 'unavailable' ? 'Temporarily unavailable. Call the store to ask about alternatives.' : 'Please call to confirm current availability before travelling.' %></p><div class="collection-item__actions"><% if (settings.phone && phoneDigits(settings.phone)) { %><a class="text-link" href="tel:<%= phoneDigits(settings.phone) %>">Call About This Fabric <span aria-hidden="true">↗</span></a><% } else { %><a class="text-link" href="/contact#contact-details">Contact the Store <span aria-hidden="true">↗</span></a><% } %><% if (settings.whatsapp && whatsappUrl(settings.whatsapp)) { %><a class="collection-whatsapp-link" href="<%= whatsappUrl(settings.whatsapp) %>?text=<%= encodeURIComponent(`Hello ${settings.businessName}, I would like to check the current availability of ${item.title}. Please let me know before I visit.`) %>" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><% } %></div></div></article><% }) %></div>
      <p class="collection-no-results" data-collection-no-results <%= selectedCategory && !collections.some((item) => item.categoryId === selectedCategory.id) ? '' : 'hidden' %>>No matching collections on this page. Try another search or choose a different category.</p>
    <% } else { %>
      <div class="empty-collection"><div class="empty-collection__mark">M.</div><p class="eyebrow"><span class="eyebrow-line"></span> THE CURRENT EDIT</p><h3><%= selectedCategory ? selectedCategory.name : 'Explore the collection in person.' %></h3><p><%= selectedCategory ? selectedCategory.description : 'Our available fabrics and designs are best explored at the store. Visit to compare options and talk through what you need for your garment.' %></p><% if (settings.phone && phoneDigits(settings.phone)) { %><a class="button button-dark" href="tel:<%= phoneDigits(settings.phone) %>">Call to Check Availability <span aria-hidden="true">↗</span></a><% } else { %><a class="button button-dark" href="/contact#contact-details">Contact the Store <span aria-hidden="true">↗</span></a><% } %></div>
    <% } %>
    <div class="collection-note"><span class="collection-note__icon">i</span><p><strong>Before you travel:</strong> this website is a showcase, not live inventory. Call the store to confirm opening hours and ask whether a particular fabric, design, or tailoring option is currently available.</p></div>
  </div></section>
  <%- include('partials/store-visit-strip') %>
</main>
<%- include('partials/footer') %>
