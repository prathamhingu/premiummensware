<%- include('partials/head') %>
<%- include('partials/nav', { activePage }) %>
<main>
  <section class="page-hero page-hero-paper"><div class="container page-hero__inner"><p class="eyebrow"><span class="eyebrow-line"></span> THE GALLERY</p><h1>Textures, tones,<br><em>and thoughtful details.</em></h1><p>A closer look at fabric, tailoring details, and the visual character of the collections. Store photographs can be added as you build your gallery.</p><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Gallery</span></div><div class="collection-hero__actions"><% if (settings.phone && phoneDigits(settings.phone)) { %><a class="button button-gold" href="tel:<%= phoneDigits(settings.phone) %>">Call the Store <span aria-hidden="true">↗</span></a><% } %><a class="button button-outline" href="/contact#contact-details">Visit Information <span aria-hidden="true">↗</span></a></div></div><div class="page-hero__image"><img src="<%= stockImages.detail %>" alt="Editorial fabric texture inspiration" fetchpriority="high"></div></section>
  <section class="section"><div class="container"><div class="gallery-intro"><div><p class="eyebrow"><span class="eyebrow-line"></span> VISUAL DETAILS</p><h2>Details are best seen <em>up close.</em></h2></div><p class="muted-copy">The gallery below displays photographs published by the store administrator. Editorial photographs are illustrations, not proof of the current inventory or actual work performed by the store.</p></div>
    <% if (gallery.length) { const galleryCategories = [...new Set(gallery.map((item) => item.category || 'Craftsmanship'))].sort(); %>
      <div class="gallery-filter-row" role="group" aria-label="Filter gallery images"><button type="button" class="filter-pill is-active" data-gallery-filter="all" aria-pressed="true">All photographs</button><% galleryCategories.forEach((category) => { %><button type="button" class="filter-pill" data-gallery-filter="<%= category %>" aria-pressed="false"><%= category %></button><% }) %></div>
      <div class="real-gallery-grid real-gallery-grid--editorial" data-real-gallery><% gallery.forEach((item, index) => { %><button class="real-gallery-card" type="button" data-lightbox data-gallery-category="<%= item.category || 'Craftsmanship' %>" data-src="<%= imageFor(item) %>" data-alt="<%= item.alt || item.title %>" data-title="<%= item.title %>"><img src="<%= imageFor(item) %>" alt="<%= item.alt || item.title %>" loading="lazy"><span class="real-gallery-card__number">/<%= String(index + 1).padStart(2, '0') %></span><span class="real-gallery-card__caption"><strong><%= item.title %></strong><small><%= item.category || 'Craftsmanship' %></small></span><span class="gallery-open-indicator" aria-hidden="true">↗</span></button><% }) %></div><p class="collection-no-results" data-gallery-no-results hidden>No photographs in this category yet.</p>
    <% } else { %>
      <div class="gallery-empty"><div class="gallery-empty__mosaic"><img src="<%= stockImages.suiting %>" alt="Editorial suiting inspiration" loading="lazy"><img src="<%= stockImages.shirting %>" alt="Editorial shirting inspiration" loading="lazy"><img src="<%= stockImages.trousers %>" alt="Editorial trouser styling inspiration" loading="lazy"></div><div class="gallery-empty__copy"><span class="eyebrow">YOUR PHOTOGRAPHS GO HERE</span><h3>Show your craft.<br><em>In your own images.</em></h3><p>Upload clear photos of fabrics, finished garments, tailoring details, and the store interior through the administrator dashboard. These images help visitors know what to expect.</p><a href="/contact#contact-details" class="button button-dark">Store Location &amp; Contact <span aria-hidden="true">↗</span></a></div></div>
    <% } %>
    <p class="image-disclaimer">Photographs uploaded by the store administrator are shown as gallery content. Editorial imagery is illustrative only.</p>
  </div></section>
  <%- include('partials/store-visit-strip') %>
</main>
<div class="lightbox" data-lightbox-dialog aria-hidden="true"><button class="lightbox__close" type="button" aria-label="Close enlarged image" data-lightbox-close>×</button><button class="lightbox__backdrop" type="button" aria-label="Close enlarged image" data-lightbox-close></button><button class="lightbox__nav lightbox__nav--previous" type="button" aria-label="Previous image" data-lightbox-prev>‹</button><figure><img src="" alt="" data-lightbox-image><figcaption data-lightbox-title></figcaption></figure><button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next image" data-lightbox-next>›</button></div>
<%- include('partials/footer') %>
