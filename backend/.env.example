# Copy to .env and use a unique random secret for this installation.
NODE_ENV=development
PORT=3000
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional public origin used for the sitemap after deployment.
SITE_URL=

# Optional appointment email notifications through the Resend HTTP API.
# Keep credentials private; do not commit .env to version control.
RESEND_API_KEY=
EMAIL_FROM=
# If blank, the business email saved in Store & Homepage Settings is used.
NOTIFICATION_EMAIL_TO=

# Optional override for isolated testing or an alternative persistent data directory.
# Do not set this in production without an intentional storage plan.
# MENSWEAR_DATA_DIR=

# Optional local password gate. Production deployment must explicitly enable it.
PREVIEW_GATE_ENABLED=false
PREVIEW_PASSWORD_HASH=
# Only for an explicitly approved public production launch; leave unset/false for private preview.
ALLOW_PUBLIC_PRODUCTION=false

# Used to bootstrap the production administrator when no admin record exists. On Render Free, keep these in the host environment because local files are ephemeral.
# Generate values locally with: npm --prefix backend run admin:bootstrap-hash
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_BCRYPT_HASH=

# Optional data/upload path overrides. The Render Free Blueprint intentionally leaves these unset; its local filesystem is ephemeral. The site seed lives in backend/data/seed-site-data.json.
MENSWEAR_DATA_DIR=
MENSWEAR_UPLOAD_DIR=
